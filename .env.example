# Copy to .env and adjust. All values are optional.

# Host interface and port to publish on. 127.0.0.1 = this machine only;
# 0.0.0.0 = reachable from your network (put a TLS reverse proxy in front).
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Image tag to build/run, e.g. ghcr.io/cdbailey/espn-mcp:latest
IMAGE=espn-mcp:latest
CONTAINER_NAME=espn-mcp

# Host path to the token file (one token per line) mounted as a Docker secret.
MCP_AUTH_TOKEN_FILE_HOST=./secrets/mcp_auth_tokens

# Optional additional comma-separated tokens. Prefer the secret file above.
MCP_AUTH_TOKENS=

MEMORY_LIMIT=256m
CPU_LIMIT=0.5
